# ============================================================
# AI Multi-Agent Smart Learning Assistant - Environment Config
# ============================================================
# Copy this file to .env and fill in your values

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# --- LangSmith (Optional - Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-langsmith-key-here
LANGCHAIN_PROJECT=ai-learning-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Application ---
APP_NAME=AI Multi-Agent Smart Learning Assistant
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1

# --- Security ---
SECRET_KEY=your-very-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/learning_assistant.db

# --- Redis (Optional) ---
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./data/vectordb
CHROMA_COLLECTION_NAME=learning_materials

# --- File Storage ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# --- Evaluation ---
DEEPEVAL_API_KEY=your-deepeval-key-here
EVALUATION_THRESHOLD_FAITHFULNESS=0.7
EVALUATION_THRESHOLD_RELEVANCE=0.7
EVALUATION_THRESHOLD_PRECISION=0.6

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Agents ---
MAX_REFLECTION_ITERATIONS=3
MAX_RETRIEVAL_DOCS=10
RETRIEVAL_TOP_K=5
HYBRID_SEARCH_ALPHA=0.5
